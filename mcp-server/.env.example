# ---- MCP server configuration ----

PORT=8090

# Auth server's JWKS endpoint — used to verify token signatures (public keys only).
JWKS_URL=http://localhost:8080/.well-known/jwks.json

# Must equal the auth server's issuer (the JWT `iss`).
EXPECTED_ISSUER=http://localhost:8080

# Must equal THIS server's URL (the JWT `aud`). In prod, your Sliplane MCP domain + /mcp.
EXPECTED_AUDIENCE=http://localhost:8090/mcp

# The "vault": subproject_id -> Sinch access key/secret.
# JSON: { "<subproject_id>": { "accessKey": "...", "accessSecret": "..." } }
SINCH_CREDENTIALS={"subproject-A":{"accessKey":"REPLACE_KEY_ID","accessSecret":"REPLACE_KEY_SECRET"},"subproject-B":{"accessKey":"REPLACE_KEY_ID","accessSecret":"REPLACE_KEY_SECRET"}}

# Sinch endpoints (defaults shown; override only if needed).
# SINCH_AUTH_URL=https://auth.sinch.com/oauth2/token
# SINCH_NUMBERS_BASE=https://numbers.api.sinch.com
# SINCH_PROVISIONING_BASE=https://provisioning.api.sinch.com

# Sinch Generative AI Rich Content Generator (RCG) — enables the `generate-rcs-message` tool.
# Company-wide Microsoft Entra (client-credentials) creds, NOT per-subproject. The tool is
# inert (returns a config error) unless all four ENTRA_* values are set.
# ENTRA_TENANT_ID=
# ENTRA_CLIENT_ID=
# ENTRA_CLIENT_SECRET=
# ENTRA_SCOPE=
# RCG_BASE_URL=https://genai.eu.saas.sinch.com
