# Copy to .env for local development. .env is gitignored; never commit real values.
# In production these are set as Sliplane service environment variables instead.

# Slack Workflow Builder "From a webhook" trigger URL for #ax-team.
# Published workflow -> Web request URL.
SLACK_WEBHOOK_URL=https://hooks.slack.com/triggers/T000000/000000/xxxxxxxxxxxx

# Auto-approve Marketplace entitlements via the Partner Procurement API.
# Keep false locally so a stray run cannot approve a real entitlement; true in production.
AUTO_APPROVE=false

# Producer id in the Procurement API path providers/<id>/entitlements/<id>.
# Defaults to sinch-build; may need to be the producer project *number* instead.
# PROCUREMENT_PROVIDER_ID=sinch-build

# --- Session auth (REQUIRED) ---
# Login is refused entirely if ADMIN_PASSWORD is unset - there is no default,
# because this repository is public.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Signs the session cookie. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
# If unset, a random per-process secret is used and every restart logs you out.
SESSION_SECRET=
# Cookie lifetime in seconds (default 12h) and https-only flag.
# SESSION_MAX_AGE=43200
# COOKIE_SECURE=true   # set false only for local http development

# --- Existing dashboard settings (documented in README.md) ---
# Producer service account key, as a single-line JSON string. Same variable name as Sliplane.
# Set it locally to test as the identity production actually uses.
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# DB_PATH=marketplace.db
# PROJECT_ID=sinch-build
# SUBSCRIPTION_ID=marketplace-events
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=
