# ---- Auth server configuration ----

# Public URL of this auth server. Used as the JWT `iss`. No trailing slash.
# Local dev example:
ISSUER_URL=http://localhost:8080
# In prod this is your Sliplane HTTPS domain, e.g. https://sinch-auth.sliplane.app

# The MCP server URL. Used as the JWT `aud`. The MCP server checks this matches itself.
AUDIENCE=http://localhost:8090/mcp

# Access-token lifetime in seconds.
ACCESS_TOKEN_TTL=3600

PORT=8080

# Signing key from `npm run gen-keys` (single line, \n-escaped). Example shape:
# PRIVATE_KEY_PEM="-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----"
PRIVATE_KEY_PEM=

# Optional: key id published in the JWKS and stamped in each JWT header.
KEY_ID=demo-key-1

# Any random string used to sign the session cookie.
SESSION_SECRET=change-me-to-something-random

# OAuth clients. Register Gemini Enterprise here once you have its redirect URI from the
# connector setup. For local testing the redirect URI below is a throwaway.
# JSON: { "<client_id>": { "clientSecret": "...", "redirectUris": ["https://..."] } }
OAUTH_CLIENTS={"gemini-enterprise":{"clientSecret":"super-secret-demo","redirectUris":["http://localhost:8080/callback"]}}

# Demo users. Map each email to a bcrypt password hash (see scripts/hash-password.ts)
# and the Sinch Build subproject they should be associated with.
# JSON: { "<email>": { "passwordHash": "...", "subprojectId": "..." } }
USERS={"antoine.sein@sinch.com":{"passwordHash":"$2a$10$REPLACE_WITH_HASH","subprojectId":"subproject-A"},"colleague@sinch.com":{"passwordHash":"$2a$10$REPLACE_WITH_HASH","subprojectId":"subproject-B"}}
